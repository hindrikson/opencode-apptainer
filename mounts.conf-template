# Format: host_path[:container_path][:ro|:rw]
#
#   - container_path defaults to host_path (same path inside as outside)
#   - mode defaults to read-only
#   - ~ on the host side = your home dir; ~ on the container side = /mnt/home/<user>
#   - @HERE = the directory containing run-agent.sh
#   - blank lines and lines starting with # are ignored

# Hand-written config, protected read-only on top of the writable directory.
# If something fails with EROFS, move that path out of this list.
@HERE/opencode/agents:~/.config/opencode/agents:ro
@HERE/opencode/skills:~/.config/opencode/skills:ro
@HERE/opencode/opencode.jsonc:~/.config/opencode/opencode.jsonc:ro
@HERE/opencode/cli.json:~/.config/opencode/cli.json:ro

# Repositories
/mnt/home/your_username/repos/some_repo:rw
~/papers:ro
~/scratch/outputs:rw

# Data directories
/mnt/data/models:ro
/mnt/data/...

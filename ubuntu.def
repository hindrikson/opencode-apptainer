Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git openssh-client \
        zsh ripgrep jq unzip tar xz-utils \
        nodejs npm

    # OpenCode (pinned)
    npm install -g opencode-ai@1.19.5
    npm cache clean --force

    # Neovim (pinned, official release)
    case "$(uname -m)" in
        aarch64) NVIM_ARCH=arm64 ;;
        x86_64)  NVIM_ARCH=x86_64 ;;
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-linux-${NVIM_ARCH}.tar.gz" \
        | tar -xz -C /opt
    ln -s "/opt/nvim-linux-${NVIM_ARCH}/bin/nvim" /usr/local/bin/nvim
    rm -rf "/opt/nvim-linux-${NVIM_ARCH}/share/man"

    mkdir -p /workspace

    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

%environment
    export LANG=C.UTF-8
    unset LD_PRELOAD

%test
    nvim --version | head -n 1
    opencode --version

Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git openssh-client \
        zsh ripgrep jq unzip tar xz-utils \
        nodejs npm

    # OpenCode 2.2.7 (pinned with allow-scripts for binary linking)
    npm install -g --allow-scripts=@opencode/cli @opencode/cli@2.2.7
    npm cache clean --force

    # Neovim (pinned, official release)
    case "$(uname -m)" in
        aarch64) NVIM_ARCH=arm64 ;;
        x86_64)  NVIM_ARCH=x86_64 ;;
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-linux-${NVIM_ARCH}.tar.gz" \
        | tar -xz -C /opt
    ln -s "/opt/nvim-linux-${NVIM_ARCH}/bin/nvim" /usr/local/bin/nvim
    rm -rf "/opt/nvim-linux-${NVIM_ARCH}/share/man"

    mkdir -p /workspace

    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

%environment
    export LANG=C.UTF-8
    unset LD_PRELOAD

%test
    # Clear host environment leaks, redirect home/logs to a writable path
    unset LD_PRELOAD
    export HOME=/tmp
    export OPENCODE_LOG_DIR="/tmp/opencode-logs"

    nvim --version | head -n 1
    opencode --version
